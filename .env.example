# OpenAI API Key (or any OpenAI-compatible provider key)
OPENAI_API_KEY=<your-openai-api-key>

# Optional: custom base URL for OpenAI-compatible APIs (e.g. Mimo)
# OPENAI_BASE_URL=https://api.xiaomimimo.com/v1

# Optional: model name (default: o1-mini-2024-09-12)
# OPENAI_MODEL=mimo-v2.5-pro

# Anthropic API Key for Claude analysis (optional fallback)
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
